node_modules/
.wrangler/
.env
.DS_Store
# Raw registry pulls are large and can be fetched again with src/fetch.mjs.
data/*_raw.jsonl
data/train_cases.jsonl
# Batch job handles from the model provider.
data/*_batch.json
# The public benchmark's tables are not ours; src/top.mjs says where to get them.
data/top/
# Backups the timestamp tool leaves behind when it upgrades a proof.
*.bak
# Local worker settings and secrets.
.dev.vars
# Forecast batches still in their holders-first window.
site/early/
# Local helper scripts and test files.
.local/
# A batch that is still in its holders-first window: its forecasts stay out of
# the repository until the window closes (src/early.mjs). Raw pulls never go in.
data/batches/*/raw.jsonl
data/batches/*/*_batch.json
# Sealed batches that are not public yet.
data/held/
