{
  "name": "brierlab",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "routes": [
    { "pattern": "brierlab.com", "custom_domain": true },
    { "pattern": "www.brierlab.com", "custom_domain": true }
  ]
}
